# ---- Secrets (never commit real values) ----
DB_PASSWORD=changeme_32_char_random_string
# ADMIN_PASSWORD_HASH must have EVERY `$` escaped as `$$` so docker compose
# env_file interpolation doesn't mangle the argon2id structure. Run
# `npm run hash-password -- <password>` from api/ and copy the ready-to-paste
# line it prints. Example shape:
# ADMIN_PASSWORD_HASH=$$argon2id$$v=19$$m=65536,t=3,p=4$$salt$$hash
ADMIN_PASSWORD_HASH=changeme_run_npm_run_hash-password
SESSION_SECRET=changeme_32_char_random_string

# ---- MinIO (remote, typically reached via WireGuard) ----
# Point MINIO_ENDPOINT at any S3-compatible MinIO instance reachable from
# the host. Common patterns:
#   - http://10.0.0.X:9000        (LAN or WireGuard peer)
#   - https://minio.example.com   (public MinIO with TLS)
# Make sure the bucket exists and the credentials have read+write+list+delete.
MINIO_ENDPOINT=http://10.0.0.2:9000
MINIO_BUCKET=annonce
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme

# ---- Runtime ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- Public origin (for CSRF Origin check and access-link generation) ----
PUBLIC_ORIGIN=https://example.fr

# ---- Caddy ----
CADDY_EMAIL=admin@example.fr
PUBLIC_HOSTNAME=example.fr
